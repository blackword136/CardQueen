<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="text_shadow">
        <item name="android:shadowColor">#FF000000</item>
        <item name="android:shadowDx">1</item>
        <item name="android:shadowDy">1</item>
        <item name="android:shadowRadius">2</item>
    </style>
    <style name="btn_sk_ch">
        <item name="android:padding">0dp</item>
        <item name="android:text">无技能</item>
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="layout_constraintWidth_percent">0.17</item>
        <item name="layout_constraintHeight_percent">0.32</item>
        <item name="android:textSize">10sp</item>
        <item name="android:backgroundTint">@color/skills_background_cantouch</item>
        <item name="strokeWidth">2dp</item>
        <item name="strokeColor">@color/skills_stroke_cantouch</item>
        <item name="cornerRadius">8dp</item>
    </style>
    <style name="btn_red_sk_ch">
        <item name="android:padding">0dp</item>
        <item name="android:text">无技能</item>
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="layout_constraintWidth_percent">0.17</item>
        <item name="layout_constraintHeight_percent">0.32</item>
        <item name="android:textSize">10sp</item>
        <item name="android:backgroundTint">@color/skills_red_background_cantouch</item>
        <item name="strokeWidth">2dp</item>
        <item name="strokeColor">@color/skills_red_stroke_cantouch</item>
        <item name="cornerRadius">8dp</item>
    </style>
    <style name="btn_sk_be_ch">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="layout_constraintWidth_percent">0.75</item>
        <item name="layout_constraintHeight_percent">0.22</item>
        <item name="android:textSize">10sp</item>
        <item name="android:backgroundTint">@color/transparent</item>
        <item name="strokeWidth">2dp</item>
        <item name="strokeColor">@color/skills_stroke_cantouch</item>
        <item name="cornerRadius">8dp</item>
    </style>
    <style name="view_skills_show">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="layout_constraintWidth_percent">0.15</item>
        <item name="layout_constraintHeight_percent">0.17</item>
        <item name="android:textSize">10sp</item>
        <item name="android:backgroundTint">@color/skills_background_notcan</item>
        <item name="strokeWidth">2dp</item>
        <item name="strokeColor">@color/skills_stroke_cantouch</item>
        <item name="cornerRadius">8dp</item>
    </style>
    <style name="btn_mode">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">65dp</item>
        <item name="layout_constraintWidth_percent">0.18</item>
        <item name="layout_constraintVertical_bias">0.05</item>
        <item name="layout_constraintHorizontal_bias">0.05</item>
        <item name="android:textSize">12sp</item>
        <item name="android:singleLine">true</item>
        <item name="android:backgroundTint">@color/transparent</item>
        <item name="strokeWidth">2dp</item>
        <item name="strokeColor">@color/skills_stroke_cantouch</item>
        <item name="cornerRadius">8dp</item>
    </style>

    <style name="btn_skills">
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="layout_constraintHeight_percent">0.1</item>
        <item name="layout_constraintWidth_percent">0.7</item>
        <item name="android:background">@color/skills_background_cantouch</item>
    </style>
