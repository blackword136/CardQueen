            app:layout_constraintTop_toBottomOf="@+id/mode_btn_1_1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/mode_btn_2_1"
            app:layout_constraintRight_toRightOf="parent"/>
        <Button
            android:id="@+id/mode_btn_6_1"
            android:text="@string/sk_mode_6_1"
