            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"/>
        <Button
            android:id="@+id/mode_btn_13_2"
            android:text="@string/sk_mode_13_2"
            style="@style/btn_mode"
            app:layout_constraintTop_toBottomOf="@+id/mode_btn_12_1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/mode_btn_13_1"
            app:layout_constraintRight_toRightOf="parent"/>
        <Button
            android:id="@+id/mode_btn_14_1"
            android:text="@string/sk_mode_14_1"
            style="@style/btn_mode"
            app:layout_constraintTop_toBottomOf="@+id/mode_btn_13_1"
