    <TextView
        android:id="@+id/enemy_text_hp"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        app:layout_constraintHeight_percent="0.07"
        android:text="敌人 hp: 50 / 50"
        style="@style/text_shadow"
        android:gravity="center"
        android:textColor="@color/white"
        android:textSize="20sp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/view_segmentation"/>
    <ProgressBar
        android:id="@+id/enemy_progress_bar"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="0dp"
        app:layout_constraintWidth_percent="0.5"
        android:layout_height="0dp"
        app:layout_constraintHeight_percent="0.02"
        android:max="50"
        android:progress="50"
        android:progressTint="#dd0000"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/enemy_text_hp"
        app:layout_constraintRight_toLeftOf="@+id/view_segmentation"/>

    <TextView
        android:id="@+id/show_text"
        android:layout_width="0dp"
        app:layout_constraintWidth_percent="0.5"
        android:layout_height="0dp"
        app:layout_constraintHeight_percent="0.08"
        android:text="信息"
        style="@style/text_shadow"
        android:gravity="center"
        android:textColor="@color/white"
        android:textSize="20sp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/enemy_progress_bar"
        app:layout_constraintRight_toLeftOf="@+id/view_segmentation"/>

    <TextView
        android:id="@+id/enemy_text_information"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="  敌人预测伤害"
        style="@style/text_shadow"
        android:gravity="center_vertical"
        android:textColor="@color/white"
        android:textSize="15sp"
        app:layout_constraintLeft_toRightOf="@id/enemy_progress_bar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintRight_toLeftOf="@id/view_segmentation"/>
    <TextView
        android:id="@+id/enemy_text_att"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="0  /  0"
        style="@style/text_shadow"
        android:gravity="center"
        android:textColor="@color/white"
        android:textSize="20sp"
        app:layout_constraintLeft_toRightOf="@id/enemy_progress_bar"
        app:layout_constraintTop_toBottomOf="@+id/enemy_text_information"
        app:layout_constraintRight_toLeftOf="@id/view_segmentation"/>

    <Button
        android:id="@+id/btn_menu"
        android:layout_width="0dp"
        app:layout_constraintWidth_percent="0.126"
        android:layout_height="0dp"
        app:layout_constraintHeight_percent="0.1"
        android:text="菜单"
        android:textSize="12sp"
        app:cornerRadius="0dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.example.text.Kilss_Button
        android:id="@+id/btn_venve_skill"
        android:layout_width="0dp"
        app:layout_constraintWidth_percent="0.126"
        android:layout_height="0dp"
        app:layout_constraintHeight_percent="0.1"
        android:text="无技能"
        android:background="@color/skills_background_cantouch"
        app:strokeWidth="2dp"
        app:strokeColor="#2196F3"
        app:cornerRadius="8dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btn_menu"
        app:layout_constraintRight_toLeftOf="@+id/show_text"
        app:layout_constraintBottom_toTopOf="@+id/layout_venve"
        >
        <TextView
            android:id="@+id/view_sk_0"
            style="@style/btn_skills_text_num"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            />
        <TextView
            android:id="@+id/btn_sk_0"
            style="@style/btn_skills_text_view"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            />
        <TextView
            android:id="@+id/cd_sk_0"
            style="@style/btn_skills_cd_view"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            />
    </com.example.text.Kilss_Button>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_venve"
        android:layout_width="0dp"
        app:layout_constraintWidth_percent="0.2"
        android:layout_height="0dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btn_venve_skill"
        app:layout_constraintBottom_toTopOf="@+id/layout_information_left"
        android:background="@color/color_gray_skills"
        android:gravity="center_horizontal"
        >


        <ScrollView
            android:id="@+id/scrollView"
            android:layout_width="0dp"
            android:layout_height="0dp"

            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:fillViewport="true">
        <TextView
            android:id="@+id/text_venve"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text=""
            android:textColor="@color/white"
            android:textSize="10sp" />
        </ScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>



<!--    <Button-->
<!--        android:id="@+id/btn_add"-->
<!--        android:layout_width="140dp"-->
<!--        android:layout_height="wrap_content"-->
<!--        android:layout_marginTop="96dp"-->
<!--        android:layout_marginRight="140dp"-->
<!--        android:text="增加手牌"-->
<!--        app:cornerRadius="0dp"-->
<!--        app:layout_constraintRight_toLeftOf="@id/view_segmentation"-->
<!--        app:layout_constraintTop_toTopOf="parent" />-->

    <Button
        android:id="@+id/btn_remove"
        android:layout_width="0dp"
        app:layout_constraintWidth_percent="0.126"
        android:layout_height="0dp"
        app:layout_constraintHeight_percent="0.15"
        android:layout_marginTop="96dp"
        android:text="打牌"
        app:cornerRadius="0dp"
        app:layout_constraintRight_toLeftOf="@id/view_segmentation"
        app:layout_constraintBottom_toTopOf="@id/turn_view" />
    <TextView
        android:id="@+id/turn_view"
        android:layout_width="0dp"
        app:layout_constraintWidth_percent="0.126"
        android:layout_height="0dp"
        app:layout_constraintHeight_percent="0.1"
        android:text="Turn: 1"
        android:gravity="center"
        android:textColor="@color/white"
        android:textSize="24sp"
        app:layout_constraintRight_toLeftOf="@id/view_segmentation"
        app:layout_constraintBottom_toTopOf="@id/layout_information_right"/>

    <LinearLayout
        android:id="@+id/layout_information_left"
        android:layout_width="0dp"
        app:layout_constraintWidth_percent="0.15"
        android:layout_height="0dp"
        app:layout_constraintHeight_percent="0.30"
        android:orientation="vertical"
        app:layout_constraintRight_toLeftOf="@id/layout_information_middle"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintBottom_toTopOf="@id/Layout_status"
        android:background="@color/color_gray_information">

        <TextView
            android:id="@+id/text_information"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="  预测伤害"
            android:gravity="center_vertical"
            android:textColor="@color/white"
            android:textSize="10sp" />
        <TextView
            android:id="@+id/text_att"
            android:layout_width="match_parent"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:text="0  /  0"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="15sp" />
        <TextView
            android:id="@+id/text_hp"
            android:layout_width="match_parent"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:text="hp: 50 / 50"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="15sp" />
        <ProgressBar
            android:id="@+id/progress_bar"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:max="50"
            android:progress="50"
            android:progressTint="#dd0000"/>
        <!--            android:progressTint="#2196F3"        &lt;!&ndash; 填充的进度颜色（蓝色） &ndash;&gt;-->
        <!--            android:backgroundTint="#cccccc" />   &lt;!&ndash; 底部轨道背景（灰色） &ndash;&gt;-->
<!--        1. `layout_constraintWidth_default`还有另外两个可选值：-->
<!--        "percent" 百分比 新版0dp时默认-->
<!--        - `spread`：默认值，填满约束剩余空间-->
<!--        - `wrap`：0dp 时自动包裹内容-->
    </LinearLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_information_middle"
        android:layout_width="0dp"
        app:layout_constraintWidth_percent="0.25"
        android:layout_height="0dp"
        app:layout_constraintHeight_percent="0.3"
        app:layout_constraintRight_toLeftOf="@id/layout_information_right_2"
        app:layout_constraintLeft_toRightOf="@id/layout_information_left"
        app:layout_constraintBottom_toTopOf="@id/Layout_status"
        android:background="@color/color_gray_information">

        <TextView
            android:id="@+id/showlast_card"
            android:layout_width="match_parent"
            android:layout_height="0dp"

            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="24sp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintBottom_toTopOf="@id/text_combo"/>
        <TextView
            android:id="@+id/text_combo"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintHeight_percent="0.25"
            android:gravity="center"
            android:textSize="20sp"
            android:textColor="@color/white"
            android:text="COMBO: 0"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@id/showlast_card"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_information_right_2"
        android:layout_width="0dp"
        app:layout_constraintWidth_percent="0.15"
        android:layout_height="0dp"
        app:layout_constraintHeight_percent="0.3"
        app:layout_constraintRight_toLeftOf="@id/layout_information_right"
        app:layout_constraintLeft_toRightOf="@id/layout_information_middle"
        app:layout_constraintBottom_toTopOf="@id/Layout_status"
        android:background="@color/color_gray_information">

        <TextView
            android:id="@+id/library_card"
            android:text="牌库：40"
            style="@style/view_card"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/abandon_card"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            />

        <TextView
            android:id="@+id/abandon_card"
            android:text="弃牌：0"
            style="@style/view_card"
            app:layout_constraintTop_toBottomOf="@+id/library_card"
            app:layout_constraintBottom_toTopOf="@+id/head_card"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            />

        <TextView
            android:id="@+id/head_card"
            android:text="手牌：0"
            style="@style/view_card"
            app:layout_constraintTop_toBottomOf="@+id/abandon_card"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            />
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_information_right"
        android:layout_width="0dp"
        app:layout_constraintWidth_percent="0.25"
        android:layout_height="0dp"
        app:layout_constraintHeight_percent="0.30"
        app:layout_constraintRight_toLeftOf="@id/view_segmentation"
        app:layout_constraintLeft_toRightOf="@id/layout_information_right_2"
        app:layout_constraintBottom_toTopOf="@id/Layout_status"
        android:background="@color/color_gray_information">
        <TextView
            android:id="@+id/hit_show_card"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="22sp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/text_xuanzei"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintBottom_toTopOf="@id/btn_end_round"/>
        <TextView
            android:id="@+id/hit_giveup"
            android:visibility="invisible"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintWidth_percent="0.15"
            app:layout_constraintHeight_percent="0.2"
            android:background="@drawable/retain"
            app:layout_constraintLeft_toLeftOf="@+id/hit_show_card"
            app:layout_constraintBottom_toBottomOf="@id/hit_show_card"/>
        <TextView
            android:id="@+id/hit_add_card"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintWidth_percent="0.15"
            app:layout_constraintHeight_percent="0.15"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="10sp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintRight_toRightOf="parent"/>
        <TextView
            android:id="@+id/text_xuanzei"
            android:layout_width="0dp"
            app:layout_constraintWidth_percent="0.15"
            android:layout_height="0dp"
            android:text="当前\n选择\n手牌"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="10sp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/hit_show_card"
            app:layout_constraintBottom_toTopOf="@id/btn_end_round"/>
        <Button
            android:id="@+id/btn_end_round"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="结束回合\nMP+0"
            android:textSize="10sp"
            android:backgroundTint="@color/color_btn_end_round"
            app:cornerRadius="0dp"

            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/Layout_status"
        android:orientation="horizontal"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintHeight_percent="0.06"
        android:textSize="18sp"
        android:gravity="center"
        android:background="@color/color_gray_information"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintBottom_toTopOf="@id/layout_tag_container"
        app:layout_constraintRight_toLeftOf="@id/view_segmentation"/>

    <com.example.text.Hardcard_LinearLayout
        android:id="@+id/layout_tag_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintHeight_percent="0.25"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@id/view_segmentation"
        app:layout_constraintBottom_toBottomOf="parent"
        />
    <!--    android:gravity="center_vertical"-->
    <View
        android:id="@+id/view_segmentation"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintWidth_percent="0.02"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintRight_toLeftOf="@id/layout_right"
        app:layout_constraintBottom_toBottomOf="parent"
        android:background="@color/color_gray_segmentation"
        />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_right"
        android:layout_height="0dp"
        android:layout_width="0dp"
        app:layout_constraintWidth_percent="0.18"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:background="@color/color_gray_skills"
        android:gravity="center_horizontal"
        >
        <TextView
            android:id="@+id/view_enemy_skill"
            android:text="敌人技能"
            style="@style/view_skills"
            android:textSize="10sp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            />
        <TextView
            android:id="@+id/view_enemy_skill_number"
            android:text="50 / 0"
            style="@style/view_skills"
            android:textSize="12sp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/view_enemy_skill"
            />
        <ProgressBar
            android:id="@+id/progress_enemy_skill"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintHeight_percent="0.02"
            android:max="50"
            android:progress="0"
            android:progressTint="#2196F3"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/view_enemy_skill_number"
            />

        <Button
            android:id="@+id/btn_enemy_skill"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:text="无技能"
            android:backgroundTint="@color/transparent"
            app:strokeWidth="2dp"
            app:strokeColor="#2196F3"
            app:cornerRadius="8dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/progress_enemy_skill"
            />

        <TextView
            android:id="@+id/view_play_skill"
            android:text="玩家技能"
            style="@style/view_skills"
            android:textSize="10sp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btn_enemy_skill"
            />
        <TextView
            android:id="@+id/view_play_skill_number"
            android:text="50 / 0"
            style="@style/view_skills"
            android:textSize="12sp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/view_play_skill"
            />
        <ProgressBar
            android:id="@+id/progress_play_skill"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintHeight_percent="0.02"
            android:max="50"
            android:progress="0"
            android:progressTint="#2196F3"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/view_play_skill_number"
            />

        <com.example.text.Kilss_Button
            android:id="@+id/btn_play_skill1"
            style="@style/btn_skills"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/progress_play_skill"
            app:layout_constraintBottom_toTopOf="@+id/btn_play_skill2"
            >
            <TextView
                android:id="@+id/view_sk_1"
                style="@style/btn_skills_text_num"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                />
            <TextView
                android:id="@+id/btn_sk_1"
                style="@style/btn_skills_text_view"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                />
            <TextView
                android:id="@+id/cd_sk_1"
                style="@style/btn_skills_cd_view"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                />
        </com.example.text.Kilss_Button>
        <com.example.text.Kilss_Button
            android:id="@+id/btn_play_skill2"
            style="@style/btn_skills"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btn_play_skill1"
            app:layout_constraintBottom_toTopOf="@+id/btn_play_skill3"
            >
            <TextView
                android:id="@+id/view_sk_2"
                style="@style/btn_skills_text_num"
                app:layout_constraintRight_toRightOf="@+id/btn_sk_2"
                app:layout_constraintTop_toTopOf="@+id/btn_sk_2"
                />
            <TextView
                android:id="@+id/btn_sk_2"
                style="@style/btn_skills_text_view"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                />
            <TextView
                android:id="@+id/cd_sk_2"
                style="@style/btn_skills_cd_view"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                />
        </com.example.text.Kilss_Button>
        <com.example.text.Kilss_Button
            android:id="@+id/btn_play_skill3"
            style="@style/btn_skills"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btn_play_skill2"
            app:layout_constraintBottom_toTopOf="@+id/btn_play_skill4"
            >
        <TextView
